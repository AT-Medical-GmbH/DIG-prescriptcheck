# PrescriptCheck – Konfiguration für den Compose-Stack. NIEMALS echte Werte committen.
# Erzeugung der Geheimnisse:  (cd ../../backend && npm run keys)   → JWT_SECRET, MASTER_KEY, SIGNING_*
# Datei auf dem Server schützen:  chmod 600 .env

DOMAIN=prescriptcheck.example.invalid

MONGO_ROOT_USER=prescriptcheck_root
MONGO_ROOT_PASSWORD=BITTE_LANGES_ZUFAELLIGES_PASSWORT_SETZEN

JWT_SECRET=
MASTER_KEY=
SIGNING_KEY_ID=1
SIGNING_PRIVATE_KEY=
# Nach einer Schlüsselrotation: alte öffentliche Schlüssel als JSON, z. B. {"1":"-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"}
SIGNING_PUBLIC_KEYS_JSON=

REQUIRE_MFA=true
# OFFEN: Gültigkeitsdauer von Privatrezepten rechtlich bestätigen
RX_VALIDITY_DAYS=28

# Optionale Footer-Links (vollständige URLs)
LINK_AGB=
LINK_DATENSCHUTZ=
LINK_DOKU=

# --- Nur für Staging/Schulung mit erfundenen Daten (niemals in Produktion, dort wird der Start verweigert) ---
# NODE_ENV=staging
# SEED_DEMO=true
# SEED_DEMO_PASSWORD=
