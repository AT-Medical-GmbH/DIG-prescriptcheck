{
  "name": "prescriptcheck-backend",
  "version": "1.0.0",
  "description": "PrescriptCheck Backend – Healthcare Prescription Validation Platform",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test": "jest --forceExit --testTimeout=10000",
    "test:coverage": "jest --coverage --forceExit --testTimeout=10000",
    "lint": "eslint . --ext .js --ignore-pattern node_modules/",
    "lint:fix": "eslint . --ext .js --fix --ignore-pattern node_modules/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.1.1",
    "morgan": "^1.11.0",
    "uuid": "^14.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests",
      "<rootDir>/../src/backend/tests",
      "<rootDir>/../tests"
    ],
    "testMatch": [
      "**/*.test.js",
      "**/*Test.js"
    ],
    "collectCoverageFrom": [
      "<rootDir>/controllers/**/*.js",
      "<rootDir>/middleware/**/*.js",
      "<rootDir>/models/**/*.js",
      "<rootDir>/routes/**/*.js",
      "<rootDir>/services/**/*.js",
      "<rootDir>/utils/**/*.js",
      "<rootDir>/../src/backend/**/*.js"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "SEE LICENSE IN ../LICENSE_COMMERCIAL.md"
}
